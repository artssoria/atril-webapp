# ═══════════════════════════════════════════════════════════
# ATRIL 5.0 - VARIABLES DE ENTORNO (PLANTILLA DE EJEMPLO)
# ═══════════════════════════════════════════════════════════
# Instrucciones:
# 1. En desarrollo local, puedes configurar tus variables aquí o en `config.js`
# 2. En Netlify: Configúralas en Site Settings > Environment variables
# 3. NUNCA subas archivos .env con credenciales reales a GitHub
# ═══════════════════════════════════════════════════════════

# URL de tu instancia de Supabase PostgreSQL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon public key)
# Obténla en Supabase Dashboard > Project Settings > API
SUPABASE_ANON_KEY=tu_supabase_anon_public_key_aqui
